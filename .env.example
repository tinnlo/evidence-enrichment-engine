# Replay mode works with blank provider keys, but keep this file present for Docker Compose.

# Observability backend selection: langfuse (default) | langsmith | dual | none
# langfuse  — emit Langfuse traces only (primary path; recommended for EU-facing teams)
# langsmith — emit LangSmith traces only
# dual      — emit both Langfuse and LangSmith
# none      — no remote traces; local artifacts (spans.jsonl etc.) are still written
OBSERVABILITY_BACKEND=langfuse

# Redact sensitive field values (candidate values, URLs, queries) from trace
# summaries sent to remote backends. Default is true (privacy-safe).
# Set to false only when you need full visibility into traced values.
TRACE_REDACT_VALUES=true

# Langfuse observability (primary; install with: pip install 'evidence_enrichment[observability]')
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=evidence-enrichment-engine

# Legacy LangSmith aliases supported for compatibility
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=evidence-enrichment-engine

# Live analysis / synthesis providers
OPENAI_API_KEY=
OPENAI_MODEL=GPT-5.4
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4.7

# Live search providers
SERPER_API_KEY=
TAVILY_API_KEY=

# Guardrails
GUARDRAILS_CONFIDENCE_FLOOR=0.4
0.4
