# Replay mode works with blank provider keys, but keep this file present for Docker Compose.

# Live analysis / synthesis providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Live search providers
SERPER_API_KEY=
TAVILY_API_KEY=

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=evidence-enrichment-engine

# Legacy LangSmith aliases supported for compatibility
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=evidence-enrichment-engine

# Optional Langfuse tracing (install with: pip install 'evidence_enrichment[observability]')
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Guardrails
GUARDRAILS_CONFIDENCE_FLOOR=0.4
