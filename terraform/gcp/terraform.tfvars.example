# Example terraform.tfvars file
# Copy this to terraform.tfvars and fill in your values

project_id = "your-gcp-project-id"
region     = "us-central1"
environment = "dev"

# Container image (update after pushing to Artifact Registry)
cloud_run_image = "us-central1-docker.pkg.dev/your-project-id/evidence-enrichment/evidence-enrichment-engine:latest"

# VPC Configuration
create_vpc          = false  # Use default VPC
vpc_connector_cidr  = "10.8.0.0/28"

# Redis Configuration
redis_tier       = "BASIC"   # Use STANDARD for prod
redis_memory_gb  = 1         # Increase for prod
redis_version    = "REDIS_7_0"

# GCS Configuration
gcs_lifecycle_age = 30       # Delete traces after 30 days
gcs_versioning    = false    # Enable for prod

# Cloud Run Job Configuration
cloud_run_cpu         = "2"
cloud_run_memory      = "2Gi"
cloud_run_timeout     = 600
cloud_run_max_retries = 3

# Observability
observability_backend = "langfuse"
langfuse_host        = "https://cloud.langfuse.com"

# Execution Policy
execution_policy_mode = "audit"  # Use "enforce" for prod

# Cloud Scheduler (optional)
enable_scheduler    = false
scheduler_cron      = "0 * * * *"  # Hourly
scheduler_timezone  = "UTC"
